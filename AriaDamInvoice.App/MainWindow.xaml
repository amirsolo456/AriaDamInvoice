<Window x:Class="AriaDamInvoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="آریا دام خاتون | مدیریت قراردادها"
        Width="960" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FlowDirection="LeftToRight" Background="{StaticResource PageBrush}">
    <Grid Margin="16" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="8,4,8,18">
            <TextBlock Text="آریا دام خاتون" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource BrandDarkBrush}"/>
            <TextBlock Text="مدیریت قراردادها" FontSize="14" Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="24"
                BorderBrush="#DFE7E5" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#243B35" Opacity="0.08" BlurRadius="22"
                                  ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid x:Name="SetupPanel" Visibility="Collapsed" VerticalAlignment="Center"
                          HorizontalAlignment="Stretch" MaxWidth="620">
                        <StackPanel>
                            <TextBlock Text="تنظیم اولیه" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="پوشه خروجی و فایل اکسل مرجع را انتخاب کنید."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,12,0,20"/>
                            <Button Height="46" MinWidth="190" HorizontalAlignment="Center"
                                    Background="{StaticResource BrandBrush}" Foreground="White"
                                    ToolTip="انتخاب پوشه ذخیره قراردادها" Click="ChooseFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                    <TextBlock Text="پوشه خروجی"/>
                                </StackPanel>
                            </Button>
                            <Button Height="46" MinWidth="190" HorizontalAlignment="Center" Background="#E8EEF0"
                                    Foreground="{StaticResource BrandDarkBrush}" ToolTip="انتخاب فایل اکسل مرجع (.xlsx)"
                                    Click="ChooseTemplate_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                    <TextBlock Text="فایل مرجع"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="SelectedTemplateText" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" TextAlignment="Center"/>
                            <TextBlock x:Name="SelectedFolderText" Margin="0,18,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" TextAlignment="Center"/>
                            <Button x:Name="SaveFolderButton" Height="46" Margin="0,20,0,0"
                                    Background="{StaticResource BrandDarkBrush}" Foreground="White"
                                    IsEnabled="False" ToolTip="ذخیره مسیرها و ادامه" Click="SaveFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                    <TextBlock Text="تأیید و ادامه"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="DashboardPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="داشبورد" FontSize="23" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="&#xE8B7;  پوشه خروجی" Margin="0,14,0,5"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="OutputFolderText" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="&#xE8A5;  فایل مرجع" Margin="0,10,0,4"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="TemplateFileText" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <UniformGrid Grid.Row="1" Columns="2" Margin="0,28,0,0">
                            <Button MinHeight="72" Margin="0,0,6,0" FontSize="16" FontWeight="SemiBold"
                                    Background="{StaticResource BrandBrush}" Foreground="White"
                                    ToolTip="صدور قرارداد جدید" Click="NewInvoice_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="قرارداد جدید"/>
                                </StackPanel>
                            </Button>
                            <Button MinHeight="72" Margin="6,0,0,0" FontSize="16" FontWeight="SemiBold"
                                    Background="#E8EEF0" Foreground="{StaticResource BrandDarkBrush}"
                                    ToolTip="مشاهده قراردادهای قبلی" Click="PreviousInvoices_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="سوابق"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                            <Button Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                    BorderBrush="#CBD5E1" BorderThickness="1"
                                    ToolTip="تغییر پوشه خروجی" Click="ChangeFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="تغییر پوشه"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,8,0,0" Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                    BorderBrush="#CBD5E1" BorderThickness="1" ToolTip="تغییر فایل اکسل مرجع"
                                    Click="ChangeTemplate_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                                    <TextBlock Text="تغییر فایل مرجع"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>