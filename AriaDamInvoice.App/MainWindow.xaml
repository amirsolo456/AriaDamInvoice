<Window x:Class="AriaDamInvoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="آریا دام خاتون | مدیریت قراردادها"
        Width="960" Height="640"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,4,8,18">
            <TextBlock Text="آریا دام خاتون"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource BrandDarkBrush}"/>
            <TextBlock Text="سامانه صدور و مدیریت قرارداد فروش دام"
                       FontSize="14" Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White"
                CornerRadius="14" Padding="24"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid x:Name="SetupPanel"
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch"
                          MaxWidth="620">
                        <StackPanel>
                            <TextBlock Text="انتخاب محل ذخیره‌سازی"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="پوشه‌ای را انتخاب کنید تا فایل‌های اکسل و PDF قراردادها در آن ذخیره شوند. در صورت انتقال برنامه به رایانه دیگر، اگر مسیر قبلی در دسترس نباشد، دوباره این مرحله نمایش داده می‌شود."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,24"/>
                            <Button Content="۱. انتخاب پوشه ذخیره قراردادها"
                                    Height="46" MinWidth="170"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource BrandBrush}"
                                    Foreground="White"
                                    Click="ChooseFolder_Click"/>
                            <Button Content="۲. انتخاب فایل اکسل مرجع قرارداد (.xlsx)" Height="46" MinWidth="260" HorizontalAlignment="Center" Background="#E8EEF0" Foreground="{StaticResource BrandDarkBrush}" Click="ChooseTemplate_Click"/>
                            <TextBlock x:Name="SelectedTemplateText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" TextAlignment="Center"/>
                            <TextBlock x:Name="SelectedFolderText"
                                       Margin="0,18,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"
                                       TextAlignment="Center"/>
                            <Button x:Name="SaveFolderButton"
                                    Content="ذخیره و ادامه"
                                    Height="46" Margin="0,22,0,0"
                                    Background="{StaticResource BrandDarkBrush}"
                                    Foreground="White"
                                    IsEnabled="False"
                                    Click="SaveFolder_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DashboardPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="داشبورد"
                                       FontSize="23" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="محل ذخیره‌سازی فایل‌ها:"
                                       Margin="0,16,0,5"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="OutputFolderText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource BrandBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="فایل اکسل مرجع:" Margin="0,12,0,4" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="TemplateFileText" TextWrapping="Wrap" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="2"
                                     Margin="0,28,0,0">
                            <Button Content="صدور قرارداد جدید"
                                    MinHeight="72" Margin="0,0,6,0"
                                    FontSize="16" FontWeight="SemiBold"
                                    Background="{StaticResource BrandBrush}"
                                    Foreground="White"
                                    Click="NewInvoice_Click"/>
                            <Button Content="قراردادهای قبلی"
                                    MinHeight="72" Margin="6,0,0,0"
                                    FontSize="16" FontWeight="SemiBold"
                                    Background="#E8EEF0"
                                    Foreground="{StaticResource BrandDarkBrush}"
                                    Click="PreviousInvoices_Click"/>
                        </UniformGrid>

                        <StackPanel Grid.Row="2"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left">
                            <Button Content="تغییر محل ذخیره‌سازی"
                                    Background="Transparent"
                                    Foreground="{StaticResource MutedBrush}"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Click="ChangeFolder_Click"/>
                            <Button Content="تغییر فایل اکسل مرجع" Margin="0,8,0,0" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderBrush="#CBD5E1" BorderThickness="1" Click="ChangeTemplate_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
