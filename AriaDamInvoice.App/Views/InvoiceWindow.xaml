<Window x:Class="AriaDamInvoice.Views.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AriaDamInvoice.Helpers"
        Title="صدور قرارداد جدید" Width="1120" Height="820"
        MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{StaticResource PageBrush}" TextElement.FontFamily="B Nazanin">
    <Window.Resources>
        <helpers:ThousandsSeparatorConverter x:Key="ThousandsSeparatorConverter"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="B Nazanin"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="B Nazanin"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="BorderBrush" Value="#D8E1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F7FAFC"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="4,0,4,14">
            <TextBlock Text="صدور قرارداد فروش دام" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}"/>
            <TextBlock Text="اطلاعات قرارداد" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="4"><TextBlock Text="شماره سند"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DocumentNumberTextBox" Padding="7" FontFamily="B Yekan" Foreground="Black" FlowDirection="LeftToRight" TextAlignment="Center" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="−" Click="DecreaseDocumentNumber_Click" Width="30" Margin="3,0,0,0" Padding="0" FontSize="18" ToolTip="کاهش شماره سند یک واحد"/><Button Grid.Column="2" Content="+" Click="IncreaseDocumentNumber_Click" Width="30" Margin="3,0,0,0" Padding="0" FontSize="18" ToolTip="افزایش شماره سند یک واحد"/></Grid></StackPanel>
                        <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="تاریخ قرارداد (شمسی)"/><TextBox x:Name="ContractDateTextBox" Margin="0,6,0,0" Padding="7" FontFamily="B Yekan" Foreground="Black" FlowDirection="LeftToRight" TextAlignment="Center" ToolTip="مثال: ۱۴۰۵/۰۸/۳۰"/><TextBlock Text="فرمت: سال/ماه/روز" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="نام خریدار"/><TextBox x:Name="BuyerNameTextBox" Margin="0,6,0,0" Padding="7" Foreground="Black"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="تلفن"/><TextBox x:Name="PhoneTextBox" Margin="0,6,0,0" Padding="7" FontFamily="B Yekan" Foreground="Black"/></StackPanel>
                        <StackPanel Grid.Column="4" Margin="4"><TextBlock Text="آدرس"/><TextBox x:Name="AddressTextBox" Margin="0,6,0,0" Padding="7" Foreground="Black"/></StackPanel>
                    </Grid>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="مشخصات دام" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Click="RemoveAnimal_Click" Margin="4,0" Background="#FEE2E2" Foreground="#991B1B" ToolTip="حذف ردیف انتخاب‌شده" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="حذف"/></StackPanel></Button>
                                <Button Click="AddBreed_Click" Margin="4,0" Background="#E8EEF0" Foreground="{StaticResource BrandDarkBrush}" ToolTip="افزودن گزینه نژاد" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="نژاد"/></StackPanel></Button>
                                <Button Click="AddAnimal_Click" Margin="4,0" Background="{StaticResource BrandBrush}" Foreground="White" ToolTip="افزودن ردیف دام" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="افزودن دام"/></StackPanel></Button>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="AnimalsGrid" FontFamily="B Nazanin" AutoGenerateColumns="False" CanUserAddRows="False"
                                  MinHeight="180" MaxHeight="360" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" SelectionMode="Single" Foreground="Black">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" IsReadOnly="True" Width="55" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="تعداد" Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="75" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="وزن" Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Width="85" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="نوع دام" Binding="{Binding AnimalType, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTemplateColumn Header="نژاد" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Breed}" VerticalAlignment="Center" Margin="5,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.BreedOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      SelectedItem="{Binding Breed, UpdateSourceTrigger=PropertyChanged}"
                                                      FontFamily="B Nazanin" IsEditable="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, Converter={StaticResource ThousandsSeparatorConverter}}" Width="110" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="جمع کل" Binding="{Binding LineTotal, Converter={StaticResource ThousandsSeparatorConverter}}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="توضیح" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="GrandTotalText" Text="جمع کل: ۰" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Left" Margin="0,12,4,0" Foreground="{StaticResource BrandDarkBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="پلاک گوش دام ارسالی" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Click="RemoveEarTag_Click" Background="#FEE2E2" Foreground="#991B1B" ToolTip="حذف پلاک انتخاب‌شده" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="حذف"/></StackPanel></Button>
                                <Button Click="AddEarTag_Click" Background="{StaticResource BrandBrush}" Foreground="White" ToolTip="افزودن پلاک گوش" Padding="10,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="افزودن پلاک"/></StackPanel></Button>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="هر پلاک در یک ردیف" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                        <DataGrid x:Name="EarTagsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" MinHeight="110" MaxHeight="260"
                                  AlternationCount="2" Foreground="Black">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" IsReadOnly="True" Width="75"/>
                                <DataGridTextColumn Header="شماره پلاک گوش" Binding="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" ElementStyle="{StaticResource NumberTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EarTagCountText" Text="تعداد پلاک: ۰" Foreground="{StaticResource MutedBrush}" Margin="4,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Click="Cancel_Click" Background="#E8EEF0" Foreground="{StaticResource BrandDarkBrush}" ToolTip="بستن بدون ذخیره"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="بستن"/></StackPanel></Button>
            <Button DockPanel.Dock="Right" Background="{StaticResource BrandBrush}" Foreground="White" Click="Save_Click" ToolTip="ذخیره اکسل و تولید PDF"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="تولید قرارداد"/></StackPanel></Button>
            <TextBlock Text="Excel + PDF" FontFamily="B Yekan" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>