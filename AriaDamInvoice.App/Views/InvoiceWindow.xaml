<Window x:Class="AriaDamInvoice.Views.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AriaDamInvoice.Helpers"
        Title="صدور قرارداد جدید" Width="1120" Height="820"
        MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{StaticResource PageBrush}" TextElement.FontFamily="B Nazanin">
    <Window.Resources>
        <helpers:ThousandsSeparatorConverter x:Key="ThousandsSeparatorConverter"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="B Nazanin"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="B Nazanin"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Foreground" Value="#172B27"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#176B57"/>
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="FontFamily" Value="B Nazanin"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F8F7"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EDF0"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#EAF1EF"/>
            <Setter Property="Foreground" Value="#173B35"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#DCE6E2"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="4,0,4,14">
            <TextBlock Text="صدور قرارداد فروش دام" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}"/>
            <TextBlock Text="اطلاعات قرارداد" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                        BorderBrush="#E2EAE7" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="شماره سند"/>
                            <Border Height="44" Margin="0,6,0,0" Background="#FFFFFF" BorderBrush="#CBD5E1"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="IncreaseDocumentNumber_Click"
                                            Width="26" Height="30" MinHeight="30" Padding="0"
                                            Margin="0,0,2,0" FontFamily="Segoe UI" FontSize="18"
                                            FontWeight="Bold" Foreground="#176B57" Content="+"
                                            ToolTip="افزایش شماره سند"/>
                                    <Button Grid.Column="1" Click="DecreaseDocumentNumber_Click"
                                            Width="26" Height="30" MinHeight="30" Padding="0"
                                            Margin="0,0,2,0" FontFamily="Segoe UI" FontSize="18"
                                            FontWeight="Bold" Foreground="#176B57" Content="−"
                                            ToolTip="کاهش شماره سند"/>
                                    <TextBox Grid.Column="2" x:Name="DocumentNumberTextBox"
                                             BorderThickness="0" Background="Transparent"
                                             Padding="5,5" FontFamily="B Yekan" Foreground="Black"
                                             FlowDirection="LeftToRight" TextAlignment="Center"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="تاریخ قرارداد (شمسی)"/><TextBox x:Name="ContractDateTextBox" Margin="0,6,0,0" Padding="9,0" FontFamily="B Yekan" FontSize="16" Foreground="Black" FlowDirection="LeftToRight" TextAlignment="Center" VerticalContentAlignment="Center" ToolTip="مثال: ۱۴۰۵/۰۸/۳۰"/><TextBlock Text="فرمت: سال/ماه/روز" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="نام خریدار"/><TextBox x:Name="BuyerNameTextBox" Margin="0,6,0,0" Padding="7" Foreground="Black"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="تلفن"/><TextBox x:Name="PhoneTextBox" Margin="0,6,0,0" Padding="7" FontFamily="B Yekan" Foreground="Black"/></StackPanel>
                        <StackPanel Grid.Column="4" Margin="4"><TextBlock Text="آدرس"/><TextBox x:Name="AddressTextBox" Margin="0,6,0,0" Padding="7" Foreground="Black"/></StackPanel>
                    </Grid>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                        BorderBrush="#E2EAE7" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="مشخصات دام" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Click="RemoveAnimal_Click" Margin="4,0" Width="42" Height="40" Padding="0" Background="#FEE2E2" Foreground="#991B1B" ToolTip="حذف ردیف انتخاب‌شده"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                                <Button Click="AddBreed_Click" Margin="4,0" Width="42" Height="40" Padding="0" Background="#E8EEF0" Foreground="{StaticResource BrandDarkBrush}" ToolTip="افزودن گزینه نژاد"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                                <Button Click="AddAnimal_Click" Margin="4,0" Width="42" Height="40" Padding="0" Background="{StaticResource BrandBrush}" Foreground="White" ToolTip="افزودن ردیف دام"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                            </StackPanel>
                        </DockPanel>
                        <Border BorderBrush="#DCE6E2" BorderThickness="1" CornerRadius="9" Padding="1" Background="White" ClipToBounds="True">
                        <DataGrid x:Name="AnimalsGrid" FontFamily="B Nazanin" AutoGenerateColumns="False" CanUserAddRows="False"
                                  MinHeight="180" MaxHeight="360" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" SelectionMode="Single" Foreground="Black">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" IsReadOnly="True" Width="55" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="تعداد" Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="75" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="وزن" Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Width="85" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="نوع دام" Binding="{Binding AnimalType, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTemplateColumn Header="نژاد" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Breed}" VerticalAlignment="Center" Margin="5,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.BreedOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      SelectedItem="{Binding Breed, UpdateSourceTrigger=PropertyChanged}"
                                                      FontFamily="B Nazanin" IsEditable="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, Converter={StaticResource ThousandsSeparatorConverter}}" Width="110" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="جمع کل" Binding="{Binding LineTotal, Converter={StaticResource ThousandsSeparatorConverter}}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource NumberTextBlockStyle}" EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                                <DataGridTextColumn Header="توضیح" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <TextBlock x:Name="GrandTotalText" Text="جمع کل: ۰" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Left" Margin="0,12,4,0" Foreground="{StaticResource BrandDarkBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                        BorderBrush="#E2EAE7" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="پلاک گوش دام ارسالی" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Click="RemoveEarTag_Click" Width="42" Height="40" Padding="0" Background="#FEE2E2" Foreground="#991B1B" ToolTip="حذف پلاک انتخاب‌شده"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                                <Button Click="AddEarTag_Click" Width="42" Height="40" Padding="0" Background="{StaticResource BrandBrush}" Foreground="White" ToolTip="افزودن پلاک گوش"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="هر پلاک در یک ردیف" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                        <Border BorderBrush="#DCE6E2" BorderThickness="1" CornerRadius="9" Padding="1" Background="White" ClipToBounds="True">
                        <DataGrid x:Name="EarTagsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" MinHeight="110" MaxHeight="260"
                                  AlternationCount="2" Foreground="Black">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" IsReadOnly="True" Width="75"/>
                                <DataGridTextColumn Header="شماره پلاک گوش" Binding="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" ElementStyle="{StaticResource NumberTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource NumberTextBoxStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <TextBlock x:Name="EarTagCountText" Text="تعداد پلاک: ۰" Foreground="{StaticResource MutedBrush}" Margin="4,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Click="Cancel_Click" Width="46" Height="42" Padding="0" Background="#E8EEF0" Foreground="{StaticResource BrandDarkBrush}" ToolTip="بستن بدون ذخیره"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></Button>
            <Button DockPanel.Dock="Right" Background="{StaticResource BrandBrush}" Foreground="White" Click="Save_Click" Width="46" Height="42" Padding="0" ToolTip="ذخیره اکسل و تولید PDF"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></Button>
            <TextBlock Text="Excel + PDF" FontFamily="B Yekan" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>